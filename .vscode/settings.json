{
  "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/dev",
  "python-envs.workspaceSearchPaths": ["./.pixi/envs/dev"],
  "python.analysis.extraPaths": ["${workspaceFolder}/tools/simulator/src"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/tools/simulator",
  "python.analysis.typeCheckingMode": "basic",
  "python.terminal.activateEnvironment": true,
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    },
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true
  },
  "python-envs.defaultEnvManager": "ms-python.python:system"
}
