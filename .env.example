# Copy to .env at the repository root for optional local mise/Compose settings.
# Already exported environment variables override these local values.
MACHINEPULSE_MQTT_ADDRESS=127.0.0.1:1883
MACHINEPULSE_MQTT_CLIENT_ID=machinepulse-gateway-local

# Published host ports for the local Compose environment. If you change the
# MQTT port, update MACHINEPULSE_MQTT_ADDRESS above to match it.
MACHINEPULSE_MQTT_PORT=1883
MACHINEPULSE_KAFKA_PORT=9092

# Optional gateway tuning; empty or unset values use the Go defaults.
# MACHINEPULSE_MQTT_SESSION_EXPIRY_SECONDS=86400
# MACHINEPULSE_MQTT_RECONNECT_CAP=60s
# MACHINEPULSE_MQTT_MAX_PACKET_BYTES=1048576
# MACHINEPULSE_GATEWAY_OPERATION_TIMEOUT=10s
# MACHINEPULSE_GATEWAY_QUARANTINE_DIR=gateway-quarantine

# Optional inclusive measurement bounds; unset means no physical range policy.
# Supply deployment-specific finite values (Celsius and absolute m/s²).
# MACHINEPULSE_GATEWAY_TEMPERATURE_MIN=
# MACHINEPULSE_GATEWAY_TEMPERATURE_MAX=
# MACHINEPULSE_GATEWAY_ACCELERATION_MAX=

# Docker Compose uses mqtt:1883 inside its network, independently of the host
# address above. Keep its gateway identity distinct from a host gateway.
# MACHINEPULSE_CONTAINER_MQTT_CLIENT_ID=machinepulse-gateway-container

# Simulator output ownership for Docker on Linux (defaults: 1000:1000).
# Set these to the output of `id -u` and `id -g` if your account differs.
# MACHINEPULSE_UID=1000
# MACHINEPULSE_GID=1000

# Optional simulator image provenance, supplied at build time. Without it,
# container-generated manifests report code_revision as null.
# MACHINEPULSE_CODE_REVISION=<source-commit-sha>
