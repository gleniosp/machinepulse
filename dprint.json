{
  "includes": ["**/*.{md,json,jsonc,yaml,yml,toml}"],
  "excludes": [
    ".git/**",
    ".pixi/**",
    ".mypy_cache/**",
    "**/.ruff_cache/**",
    "tools/simulator/.pytest_cache/**",
    "**/__pycache__/**",
    "simulator-output/**",
    "tools/simulator/tests/fixtures/**",
    "mise.lock",
    "pixi.lock"
  ],
  "oxc": {
    "markdown.enabled": true,
    "proseWrap": "preserve",
    "embeddedLanguageFormatting": "off"
  },
  "plugins": [
    "https://github.com/dprint/dprint-plugin-oxc/releases/download/0.48.0/plugin.wasm@ab83ae1cc1194d3791c9dd1593edd32e8f2bcef921ab47b0940d97459a04bf9a"
  ]
}
